# Frontend runtime/build configuration
# Copy this file to .env.development or .env.production and adjust as needed.

# API base path used by the frontend and nginx reverse proxy.
# 访问路径前缀
VITE_API_BASE_URL='/api/v1'

# 控制是否显示测试路由
VITE_SHOW_TEST_ROUTES=false

# 是否使用本地路由
VITE_USE_LOCAL_ROUTE=false

# 是否触发延迟发送请求
VITE_DELAY_REQUEST=false

# 启用mock
VITE_USE_MOCK=false