# Nginx runtime configuration used by deploy/docker-compose.yml.
# Copy this file to deploy/.env if you want to override the defaults,
# or pass it directly with docker compose --env-file deploy/.env.template.

NGINX_LISTEN_PORT=80
NGINX_SERVER_NAME=_
NGINX_REAL_IP_FROM=0.0.0.0
NGINX_REAL_IP_HEADER=X-Forwarded-For
NGINX_REAL_IP_RECURSIVE=on
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_SERVER_TOKENS=off
NGINX_GZIP=on
NGINX_GZIP_TYPES=text/plain text/css application/javascript application/json application/xml image/svg+xml
NGINX_GZIP_MIN_LENGTH=1024
NGINX_BACKEND_UPSTREAM=http://host.docker.internal:8899
NGINX_PROXY_CONNECT_TIMEOUT=5s
NGINX_PROXY_SEND_TIMEOUT=30s
NGINX_PROXY_READ_TIMEOUT=30s